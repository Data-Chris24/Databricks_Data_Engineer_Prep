# Copy to grading/.env and fill in ONE provider. grading/.env is gitignored.
# Never commit real credentials.

# ---------------------------------------------------------------------------
# Option 1: Databricks Foundation Model APIs  (recommended)
# Uses the workspace you already have - no extra signup, no extra bill.
# ---------------------------------------------------------------------------
GRADER_PROVIDER=databricks
DATABRICKS_PROFILE=FREE
GRADER_MODEL=databricks-claude-sonnet-4-5

# ---------------------------------------------------------------------------
# Option 2: Anthropic API
# ---------------------------------------------------------------------------
# GRADER_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# GRADER_MODEL=claude-sonnet-4-5

# ---------------------------------------------------------------------------
# Option 3: OpenAI API
# ---------------------------------------------------------------------------
# GRADER_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# GRADER_MODEL=gpt-4o

# Optional: cap spend per grading run.
GRADER_MAX_OUTPUT_TOKENS=2000
